<Window x:Class="Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Filmek"
        mc:Ignorable="d"
        Title="Filmek" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Button Content="Filmek betöltése"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="betoltes"/>

            <Button Content="Hány könyv van?"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="hanyfilm"/>
            
            <Button Content="Melyik a leghosszabb könyv?"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="leghosszabbfilm"/>
            <Button Content="Átlagos oldaszám"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="atlagertekeles"/>
            <Button Content="Csak sci-fi filmek"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="csakscifi"/>
            <Button Content="Csak címek"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="csakcimek"/>
            <Button Content="Csak címek"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="csakcimek"/>
            <Button Content="Rendezés cím szerint"
                    Width="150"
                    Margin="10"
                    Padding="5"
                    Click="cimrendszer"/>
        </StackPanel>

        <DataGrid x:Name="datagrid"
                  Grid.Column="1"
                  Margin="10"
                  IsReadOnly="True"
                  AutoGenerateColumns="True"/>
    </Grid>
</Window>